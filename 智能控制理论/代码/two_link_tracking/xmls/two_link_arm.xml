<mujoco model="two_link_arm">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>

  <default>
    <joint type="hinge" damping="0.02" armature="0.001"/>
    <site size="0.001" rgba="0 0 0 0"/>
  </default>

  <asset>
    <material name="t1_light_gray" rgba="0.76 0.76 0.76 1"/>
    <material name="t1_medium_gray" rgba="0.2 0.2 0.2 1"/>
    <mesh name="t1_shoulder_shell" file="../../asset_zoo/robots/booster_t1/xmls/assets/AL1.stl"/>
    <mesh name="t1_shoulder_roll_shell" file="../../asset_zoo/robots/booster_t1/xmls/assets/AL2.stl"/>
    <mesh name="t1_upper_arm" file="../../asset_zoo/robots/booster_t1/xmls/assets/AL3.stl"/>
    <mesh name="t1_left_hand" file="../../asset_zoo/robots/booster_t1/xmls/assets/left_hand_link.stl"/>
  </asset>

  <worldbody>
    <light name="light" pos="0 0 3"/>
    <camera name="fixed" pos="0 -3.2 1.3" xyaxes="1 0 0 0 0 1"/>
    <body name="base" pos="0 0 1">
      <body name="arm_yaw_offset" quat="0.7071068 0 0 -0.7071068">
        <body name="shoulder_pitch_offset" quat="0.7071068 0.7071068 0 0">
          <geom name="shoulder_t1_mesh" type="mesh" mesh="t1_shoulder_shell" material="t1_light_gray"
            contype="0" conaffinity="0" density="0"/>
          <body name="link1" pos="0 0.047 0">
            <joint name="joint1" axis="1 0 0"/>
            <inertial pos="0 0.3 0" mass="1.5" diaginertia="0.2 0.01 0.2"/>
            <geom name="shoulder_roll_t1_mesh" type="mesh" mesh="t1_shoulder_roll_shell" material="t1_light_gray"
              contype="0" conaffinity="0" density="0"/>
            <site name="elbow_site" pos="0.00025 0.0605 0"/>
            <body name="elbow_pitch_offset" pos="0.00025 0.0605 0" quat="0.7071068 0 0.7071068 0">
              <geom name="link1_t1_mesh" type="mesh" mesh="t1_upper_arm" material="t1_light_gray"
                contype="0" conaffinity="0" density="0"/>
              <body name="link2" pos="0 0.1471 0">
                <joint name="joint2" axis="0 0 1"/>
                <inertial pos="0 0.3 0" mass="1.5" diaginertia="0.2 0.01 0.2"/>
                <geom name="left_hand_t1_mesh" type="mesh" mesh="t1_left_hand" material="t1_medium_gray"
                  contype="0" conaffinity="0" density="0"/>
                <site name="ee_site" pos="0 0.215 0"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="joint1" joint="joint1" gear="1" ctrllimited="true" ctrlrange="-25 25"/>
    <motor name="joint2" joint="joint2" gear="1" ctrllimited="true" ctrlrange="-25 25"/>
  </actuator>

  <sensor>
    <jointpos name="joint1_pos" joint="joint1"/>
    <jointpos name="joint2_pos" joint="joint2"/>
  </sensor>
</mujoco>
