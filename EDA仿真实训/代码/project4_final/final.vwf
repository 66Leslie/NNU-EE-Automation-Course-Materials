TRANSITION_LIST("clk")
{
	NODE
	{
		REPEAT = 1;
		NODE
		{
			REPEAT = 360000;
			LEVEL 0 FOR 10000000.0;
			LEVEL 1 FOR 10000000.0;
		}
	}
}

